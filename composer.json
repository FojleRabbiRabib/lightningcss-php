{
  "name": "lightningcss-php/lightningcss",
  "description": "Lightning CSS in-process for PHP: transform, minify, bundle, and source maps without Node.js, backed by a statically linked vendored Lightning CSS",
  "type": "php-ext",
  "license": "Apache-2.0",
  "keywords": ["css", "minify", "lightningcss", "postcss", "stylesheet"],
  "homepage": "https://github.com/FojleRabbiRabib/lightningcss-php",
  "authors": [
    {
      "name": "Fojle Rabbi (Rabib)",
      "role": "Lead"
    }
  ],
  "support": {
    "issues": "https://github.com/FojleRabbiRabib/lightningcss-php/issues",
    "source": "https://github.com/FojleRabbiRabib/lightningcss-php",
    "docs": "https://github.com/FojleRabbiRabib/lightningcss-php/blob/main/docs/installation.md"
  },
  "php-ext": {
    "extension-name": "lightningcss",
    "download-url-method": ["pre-packaged-binary", "composer-default"]
  },
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0"
  },
  "require-dev": {
    "nikic/php-parser": "^5.0",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "config": {
    "allow-plugins": {},
    "sort-packages": true
  },
  "scripts": {
    "lint:php": "phpcs",
    "analyse": "tools/phpstan.sh"
  }
}
