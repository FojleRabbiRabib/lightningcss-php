<?xml version="1.0"?>
<ruleset name="lightningcss">
    <description>PHP standard for the lightningcss extension: PSR-12 with two documented exceptions.</description>

    <rule ref="PSR12">
        <!-- The extension stub declares the whole public API in one file by design;
             one-class-per-file targets runtime classes. -->
        <exclude name="PSR1.Classes.ClassDeclaration.MultipleClasses"/>
        <!-- Test libraries and tools, as they land, are executable diagnostics:
             defining helper symbols and executing the diagnostic in one file is
             their design. -->
        <exclude name="PSR1.Files.SideEffects"/>
    </rule>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <!-- Vendored upstream tooling follows php-src's own style, not PSR-12. -->
    <exclude-pattern>tools/gen_stub\.php</exclude-pattern>

    <file>lightningcss.stub.php</file>
    <file>tests</file>
    <file>tools</file>
</ruleset>
